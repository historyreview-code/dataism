{
  "name": "dataism-studios",
  "version": "1.0.0",
  "private": true,
  "description": "Dataism Studios — interactive particle-art installations. Monorepo with @studio/dataism-core as the shared engine.",
  "scripts": {
    "dev:17": "pnpm --filter dataism-17 dev",
    "build:17": "pnpm --filter dataism-17 build",
    "preview:17": "pnpm --filter dataism-17 preview",
    "dev:exhibit": "pnpm --filter dataism-exhibit dev",
    "build:exhibit": "pnpm --filter dataism-exhibit build",
    "preview:exhibit": "pnpm --filter dataism-exhibit preview",
    "dev:storm": "pnpm --filter dronestorm dev",
    "build:storm": "pnpm --filter dronestorm build",
    "build:all": "pnpm build:17 && pnpm build:exhibit && pnpm build:storm",
    "dev": "pnpm dev:exhibit",
    "build": "pnpm build:exhibit"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.3"
}